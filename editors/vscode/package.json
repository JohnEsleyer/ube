{
  "name": "ube",
  "displayName": "Ube Language",
  "description": "Official language support for Ube: syntax highlighting, snippets, and file icon 🍠",
  "version": "0.4.0",
  "publisher": "ube-lang",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ube",
        "aliases": ["Ube", "ube"],
        "extensions": [".ube"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.svg",
          "dark": "./icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "ube",
        "scopeName": "source.ube",
        "path": "./syntaxes/ube.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "ube",
        "path": "./snippets/ube.code-snippets"
      }
    ]
  }
}
