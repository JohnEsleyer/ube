{
  "name": "ube",
  "displayName": "Ube Language Support",
  "description": "Official VS Code extension for Ube: syntax highlighting, snippets, formatting, and language server.",
  "version": "1.0.0",
  "publisher": "johnesleyer",
  "license": "MIT",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:ube"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/JohnEsleyer/ube"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "ube",
    "webassembly",
    "wasm",
    "zero-gc",
    "arena"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ube",
        "aliases": [
          "Ube",
          "ube"
        ],
        "extensions": [
          ".ube"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/ube.svg",
          "dark": "./icons/ube.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "ube",
        "scopeName": "source.ube",
        "path": "./syntaxes/ube.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "ube",
        "path": "./snippets/ube.code-snippets"
      }
    ],
    "iconThemes": [
      {
        "id": "ube-icons",
        "label": "Ube File Icons",
        "path": "./icons/ube-icon-theme.json"
      }
    ],
    "commands": [
      {
        "command": "ube.restartServer",
        "title": "Ube: Restart Language Server",
        "category": "Ube"
      },
      {
        "command": "ube.runFile",
        "title": "Ube: Run Current File (ube run)",
        "category": "Ube"
      },
      {
        "command": "ube.checkFile",
        "title": "Ube: Check Safety & Types (ube check)",
        "category": "Ube"
      },
      {
        "command": "ube.formatFile",
        "title": "Ube: Format Document (ube fmt)",
        "category": "Ube"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Ube Configuration",
      "properties": {
        "ube.compilerPath": {
          "type": "string",
          "default": "ube",
          "description": "Path to the ube compiler executable."
        },
        "ube.lsp.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable Language Server Protocol integration via 'ube lsp'."
        },
        "ube.lsp.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the Ube language server."
        }
      }
    },
    "configurationDefaults": {
      "[ube]": {
        "editor.tokenColorCustomizations": {
          "[Default Dark+]": {
            "textMateRules": [
              {
                "scope": "keyword.other.affine.move.ube",
                "settings": {
                  "foreground": "#F59E0B",
                  "fontStyle": "bold"
                }
              }
            ]
          },
          "[Default Light+]": {
            "textMateRules": [
              {
                "scope": "keyword.other.affine.move.ube",
                "settings": {
                  "foreground": "#B45309",
                  "fontStyle": "bold"
                }
              }
            ]
          },
          "textMateRules": [
            {
              "scope": "keyword.other.affine.move.ube",
              "settings": {
                "foreground": "#E5A00D",
                "fontStyle": "bold"
              }
            }
          ]
        }
      }
    }
  },
  "scripts": {
    "compile": "npx esbuild src/extension.ts --bundle --outfile=extension.js --external:vscode --format=cjs --platform=node",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "vscode-languageclient": "^8.1.0"
  },
  "icon": "icon.png"
}
