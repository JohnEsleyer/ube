{
  "name": "ube",
  "displayName": "Ube Language",
  "description": "Syntax highlighting, language configuration, and snippets for the Ube programming language 🍠",
  "version": "0.7.0",
  "publisher": "ube-lang",
  "repository": {
    "type": "git",
    "url": "https://github.com/ube-lang/ube"
  },
  "icon": "icon.png",
  "main": "./client/out/extension.js",
  "activationEvents": ["onLanguage:ube"],
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "configuration": {"title":"Ube","properties":{"ube.serverPath":{"type":"string","default":"ubec","description":"Path to the ubec compiler executable"}}},
    "languages": [
      {
        "id": "ube",
        "aliases": [
          "Ube",
          "ube"
        ],
        "extensions": [
          ".ube"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/ube.svg",
          "dark": "./icons/ube.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "ube",
        "scopeName": "source.ube",
        "path": "./syntaxes/ube.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "ube",
        "path": "./snippets/ube.code-snippets"
      }
    ],
    "iconThemes": [
      {
        "id": "ube-file-icons",
        "label": "Ube",
        "path": "./icons/ube-icon-theme.json"
      }
    ]
  },
  "scripts": {"vscode:prepublish":"npm run compile","compile":"tsc -b client","watch":"tsc -b client -w"},
  "dependencies": {"vscode-languageclient":"^9.0.1"},
  "devDependencies": {"@types/node":"^18.19.0","@types/vscode":"^1.70.0","typescript":"^5.0.0"}
}
