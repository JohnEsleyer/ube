{
  "name": "ube",
  "displayName": "Ube Language",
  "description": "Syntax highlighting, language configuration, and snippets for the Ube programming language 🍠",
  "version": "0.5.0",
  "publisher": "ube-lang",
  "repository": {
    "type": "git",
    "url": "https://github.com/ube-lang/ube"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ube",
        "aliases": ["Ube", "ube"],
        "extensions": [".ube"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.svg",
          "dark": "./icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "ube",
        "scopeName": "source.ube",
        "path": "./syntaxes/ube.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "ube",
        "path": "./snippets/ube.code-snippets"
      }
    ]
  }
}
