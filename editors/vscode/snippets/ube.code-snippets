{
  "Main Function": {
    "prefix": "main",
    "body": [
      "fn main() {",
      "\t$0",
      "}"
    ],
    "description": "Program entry point"
  },
  "Function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:params}) ${3:-> ${4:i32} }{",
      "\t$0",
      "}"
    ],
    "description": "Function definition"
  },
