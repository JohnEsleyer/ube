{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ube",
  "scopeName": "source.ube",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ube",
          "match": "//.*$"
        },
        {
          "name": "comment.block.ube",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ube",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.ube",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.ube",
          "match": "\\b(if|else|while|for|in|return|break|continue|match|select|spawn|scope|unsafe|defer|or_else)\\b"
        },
        {
          "name": "keyword.other.ube",
          "match": "\\b(import|struct|enum|let|mut|fn|extern)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.ube",
          "match": "\\b(i32|u32|i64|u64|u8|f32|f64|bool|string|void)\\b"
        },
        {
          "name": "support.type.collection.ube",
          "match": "\\b(Chan|Pool|UbeHandle)\\b"
        },
        {
          "name": "entity.name.type.ube",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.ube",
          "match": "\\b(true|false|null)\\b"
        },
        {
          "name": "constant.numeric.float.ube",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.hexadecimal.ube",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.integer.binary.ube",
          "match": "\\b0b[01]+\\b"
        },
        {
          "name": "constant.numeric.integer.ube",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\bfn\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "entity.name.function.ube"
            }
          }
        },
        {
          "match": "\\bfn\\s*\\(.*?\\)\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "entity.name.function.receiver.ube"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.ube",
          "match": "(\\?|!|->|=>|\\+|-|\\*|/|==|!=|<=|>=|<|>|=|&)"
        }
      ]
    }
  }
}
