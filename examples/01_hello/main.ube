		g.emit("{")
		g.indent++
		frameTmp := g.newTmp()
		g.scopeMarks = append(g.scopeMarks, frameTmp)
		g.emit(fmt.Sprintf("UbeArenaLevel %s;", frameTmp))
		g.emit(fmt.Sprintf("ube_arena_enter(&%s);", frameTmp))
		g.genBlock(s.Body)
		g.emit(fmt.Sprintf("ube_arena_exit(&%s);", frameTmp))
