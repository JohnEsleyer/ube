<search>
	"break":    TokenBreak,
	"continue": TokenContinue,
	"scope":    TokenScope,
	"arena":    TokenArena,
	"promote":  TokenPromote,
</search>
<with>
	"break":    TokenBreak,
	"continue": TokenContinue,
	"arena":    TokenArena,
	"promote":  TokenPromote,
</with>
</replace>

