package main

fn main() {
    // Immutable bindings by default
    let year: i32 = 2026
    let pi: f32 = 3.14159
    let active: bool = true

    // Type inference
    let name = "Ube Language"

    // Mutable variable binding
    let mut score = 100
    score += 50
    score *= 2

    println(f"Year: {year}, Active: {active}")
    println(f"Score: {score}")
}