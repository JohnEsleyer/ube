package main

struct Counter {
    val: i32
}

fn add(a: i32, b: i32) -> i32 {
    return a + b
}

// Value receiver (read-only borrow)
fn (c Counter) read() -> i32 {
    return c.val
}

// Mutable receiver (in-place modification)
fn (mut c Counter) bump(amount: i32) {
    c.val += amount
}

fn main() {
    let mut c = Counter{ val: 10 }
    println(c.read()) // 10

    c.bump(5)
    println(c.read()) // 15
    println(add(5, 7)) // 12
}