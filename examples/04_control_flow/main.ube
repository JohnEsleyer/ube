package main

fn main() {
    let mut count = 0

    // While loop
    while count < 3 {
        println(f"Count is {count}")
        count += 1
    }

    // If-else conditional branch
    let target = 10
    if target > 5 {
        println("Target is large")
    } else {
        println("Target is small")
    }
}