package main

struct Position {
    x: f32,
    y: f32
}

struct Player {
    id: i32,
    Position // Anonymous field embedding
}

fn main() {
    let p = Player{
        id: 42,
        Position: Position{ x: 100.0, y: 250.0 }
    }

    // Promoted field access from embedded Position struct
    println(p.id) // 42
    println(p.x)  // 100.0
    println(p.y)  // 250.0
}