package main

enum Command {
    Jump(f32),
    Say(string),
    Quit
}

fn process_command(cmd: Command) {
    match cmd {
        Jump(height) => println(f"Jumping to height {height}"),
        Say(msg)     => println(f"Saying: {msg}"),
        Quit         => println("Quitting program")
    }
}

fn main() {
    process_command(Command.Jump(5.5))
    process_command(Command.Say("Ready!"))
    process_command(Command.Quit)
}