package main

fn sum_slice(vals: []i32) -> i32 {
    let mut total = 0
    for v in vals {
        total += v
    }
    return total
}

fn main() {
    // Fixed stack-allocated array coerced to a dynamic slice
    let fixed_arr = [3]i32{10, 20, 30}
    println(sum_slice(fixed_arr)) // 60

    // Dynamic arena-backed slice
    let mut numbers = []i32{}
    numbers.push(5)
    numbers.push(15)
    println(numbers.len) // 2
}