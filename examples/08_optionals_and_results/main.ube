package main

fn parse_port(code: i32) -> i32 ! string {
    if code < 1024 || code > 65535 {
        return error("invalid network port range")
    }
    return code
}

fn find_item(id: i32) -> string? {
    if id == 7 {
        return "Excalibur"
    }
    return none
}

fn main() {
    // Result handling via or_else fallback
    let port = parse_port(80) or_else 8080 // Note: standard fallback operator is 'or_else'
    let safe_port = parse_port(-1) or_else 3000
    println(safe_port) // 3000

    // Optional unwrapping via if let
    if let item = find_item(7) {
        println(f"Found item: {item}")
    } else {
        println("Item not found")
    }
}