// Generic struct
struct Box[T] {
    val: T
}

fn (b Box[T]) unwrap() -> T {
    return b.val
}

// Trait definition
trait Speaker {
    fn speak() -> string
}

struct Dog {
    name: string
}

fn (d Dog) speak() -> string {
    return "Woof!"
}

// Dynamic dispatch via trait fat pointer
fn announce(s: Speaker){
    println_str(s.speak())
}

fn main(){
    let int_box = Box[i32]{val: 42}
    println(int_box.unwrap()) // 42

    let d = Dog{name: "Buddy"}
    announce(d) // Woof!
}
