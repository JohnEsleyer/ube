package main

trait Describable {
    fn describe() -> string
}

struct Item {
    name: string
}

fn (i Item) describe() -> string {
    return f"Item: {i.name}"
}

fn print_description(d: Describable) {
    println(d.describe())
}

fn main() {
    let item = Item{ name: "Health Potion" }
    print_description(item)
}