package main

fn main() {
    let mut persistent = []i32{}

    arena {
        let mut scratch = []i32{}
        scratch.push(42)
        scratch.push(100)

        // Deep-copy rescue from inner scratch region to outer arena region
        persistent = promote(scratch)
    } // Scratch memory arena wiped entirely in 1 instruction

    println(persistent.len) // 2
    println(persistent[0])  // 42
}