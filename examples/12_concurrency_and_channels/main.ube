
fn worker(jobs: Chan[i32], done: Chan[bool]){
    while let job = jobs.recv(){
        print("Worker processed: ")
        println(job)
    }
    done.send(true)
}

fn main(){
    let jobs = Chan[i32](5)
    let done = Chan[bool](1)

    spawn worker(jobs, done)

    jobs.send(100)
    jobs.send(200)
    jobs.close()

    // Multiplexing channels with select using '=>'
    select {
         is_done = done => {
            println("Worker completed all jobs.")
        }
        default => {
            println("Worker still busy...")
        }
    }
}
