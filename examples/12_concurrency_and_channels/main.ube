package main

fn worker(inbox: Chan[i32], done: Chan[bool]) {
    while let msg = inbox.recv() {
        println(f"Worker received job ID: {msg}")
    }
    done.send(true)
}

fn main() {
    let inbox = Chan[i32].new(4)
    let done = Chan[bool].new(1)

    spawn worker(inbox, done)

    inbox.send(100)
    inbox.send(200)
    inbox.close()

    let success = done.recv() or_else false
    println(f"Worker finished status: {success}")
}