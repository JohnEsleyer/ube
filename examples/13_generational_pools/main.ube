package main

struct Actor {
    health: i32
}

fn main() {
    let mut pool = Pool[Actor].new(16)
    let handle = pool.spawn(Actor{ health: 100 })

    if let actor = pool.get(handle) {
        println(f"Actor health: {actor.health}") // 100
    }

    pool.despawn(handle)

    // Subsequent lookups with stale handle safely return none
    if let _ = pool.get(handle) {
        println("Found old handle")
    } else {
        println("Handle is safely invalidated")
    }
}