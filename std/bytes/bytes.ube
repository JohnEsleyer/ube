// File: std/bytes/bytes.ube

// Ube standard library: byte buffers and byte slices.

pub struct ByteBuffer {
    pub data: []u8,
    pub count: i32
}

pub fn buffer_new(capacity: i32) -> ByteBuffer {
    return ByteBuffer {
        data: []u8{},
        count: 0
    }
}

pub fn (mut b ByteBuffer) write_u8(val: u8) {
    b.data.push(val)
    b.count += 1
}

pub fn (mut b ByteBuffer) write_bytes(data: []u8) {
    let mut i = 0
    while i < data.len {
        b.data.push(data[i])
        i += 1
    }
    b.count = b.data.len
}

pub fn (b ByteBuffer) len() -> i32 {
    return b.count
}

pub fn (b ByteBuffer) is_empty() -> bool {
    return b.count == 0
}

pub fn (mut b ByteBuffer) reset() {
    b.data = []u8{}
    b.count = 0
}

pub fn (b ByteBuffer) get(idx: i32) -> u8 {
    return b.data[idx]
}

pub fn (b ByteBuffer) to_slice() -> []u8 {
    return b.data
}
