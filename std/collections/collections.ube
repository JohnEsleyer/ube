package collections

// File: std/collections/collections.ube

// Ube standard library: slice-backed collections.
//
// Ube has no raw pointers or manual malloc/free. These collections therefore
// store their elements in a dynamic slice ([]T), which the runtime manages.

pub struct Stack[T] {
    pub items: []T
}

pub fn stack_new[T]() -> Stack[T] {
    return Stack[T] {
        items: []T{}
    }
}

pub fn (mut s Stack[T]) push(item: T) {
    s.items.push(item)
}

pub fn (mut s Stack[T]) pop() -> T? {
    if s.items.len == 0 {
        return none
    }
    return s.items.pop()
}

pub fn (s Stack[T]) len() -> i32 {
    return s.items.len
}

pub fn (s Stack[T]) is_empty() -> bool {
    return s.items.len == 0
}

// Iterator protocol: `for item in stack { ... }` pops until the stack is
// empty. `next` is called on a mutable receiver, matching the typechecker's
// custom-iterator convention.
pub fn (mut s Stack[T]) next() -> T? {
    return s.pop()
}

pub struct Pair[K, V] {
    pub key: K,
    pub val: V
}

pub struct SimpleMap[K, V] {
    pub entries: []Pair[K, V]
}

pub fn map_new[K, V]() -> SimpleMap[K, V] {
    return SimpleMap[K, V] {
        entries: []Pair[K, V]{}
    }
}

pub fn (mut m SimpleMap[K, V]) put(key: K, val: V) {
    // Append-only storage keeps the move checker happy (the generic value can
    // only be consumed once). get() scans from the end so the last write wins.
    m.entries.push(Pair[K, V]{ key: key, val: val })
}

pub fn (m SimpleMap[K, V]) get(key: K) -> V? {
    let mut i = m.entries.len - 1
    while i >= 0 {
        if m.entries[i].key == key {
            return m.entries[i].val
        }
        i -= 1
    }
    return none
}

pub fn (m SimpleMap[K, V]) len() -> i32 {
    let mut count = 0
    let mut i = 0
    while i < m.entries.len {
        let mut seen = false
        let mut j = 0
        while j < i {
            if m.entries[j].key == m.entries[i].key {
                seen = true
                break
            }
            j += 1
        }
        if !seen {
            count += 1
        }
        i += 1
    }
    return count
}
