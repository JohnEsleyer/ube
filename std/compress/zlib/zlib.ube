package zlib

// File: std/compress/zlib/zlib.ube
//
// RFC 1950 zlib container with RFC 1951 DEFLATE stored blocks.
//
// `compress` emits a valid zlib stream using uncompressed DEFLATE blocks. This
// keeps the implementation dependency-free and deterministic while remaining
// readable by any conforming zlib/DEFLATE decoder. `decompress` accepts stored
// blocks and verifies the trailing Adler-32 checksum.

import "std/hash"

fn push_u16_le(mut out: []u8, value: i32) {
    out.push((value & 255) as u8)
    out.push(((value >> 8) & 255) as u8)
}

fn push_u32_be(mut out: []u8, value: u32) {
    out.push(((value >> 24) & 255) as u8)
    out.push(((value >> 16) & 255) as u8)
    out.push(((value >> 8) & 255) as u8)
    out.push((value & 255) as u8)
}

pub fn compress(input: []u8) -> []u8 {
    let mut out = []u8{}
    // CMF: CM=8 (DEFLATE), CINFO=7 (32K window). FLG: FCHECK chosen so that
    // (CMF * 256 + FLG) is a multiple of 31, no dictionary.
    out.push(0x78)
    out.push(0x01)

    let n = input.len
    if n == 0 {
        out.push(1) // BFINAL=1, BTYPE=00
        push_u16_le(mut out, 0)
        push_u16_le(mut out, 0xFFFF)
    } else {
        let mut offset = 0
        while offset < n {
            let mut remaining = n - offset
            let mut chunk = remaining
            if chunk > 65535 {
                chunk = 65535
            }
            let final_block = offset + chunk >= n
            if final_block {
                out.push(1)
            } else {
                out.push(0)
            }
            push_u16_le(mut out, chunk)
            push_u16_le(mut out, (~chunk) & 0xFFFF)
            let mut i = 0
            while i < chunk {
                out.push(input[offset + i])
                i += 1
            }
            offset += chunk
        }
    }

    let checksum = hash.adler32(input)
    push_u32_be(mut out, checksum)
    return out
}

pub fn decompress(input: []u8) -> []u8 ! string {
    if input.len < 6 {
        return error("zlib stream is too short")
    }
    let cmf = input[0] as i32
    let flg = input[1] as i32
    if (cmf & 15) != 8 {
        return error("zlib stream does not use DEFLATE")
    }
    if (((cmf << 8) | flg) % 31) != 0 {
        return error("invalid zlib header checksum")
    }
    if (flg & 32) != 0 {
        return error("zlib preset dictionaries are not supported")
    }

    let mut out = []u8{}
    let mut pos = 2
    let mut final_block = false
    while !final_block {
        if pos >= input.len {
            return error("truncated zlib DEFLATE block")
        }
        let header = input[pos] as i32
        pos += 1
        final_block = (header & 1) == 1
        let block_type = (header >> 1) & 3
        if block_type != 0 {
            return error("only stored DEFLATE blocks are supported")
        }
        if pos + 4 > input.len {
            return error("truncated zlib stored block header")
        }
        let len = (input[pos] as i32) | ((input[pos + 1] as i32) << 8)
        let nlen = (input[pos + 2] as i32) | ((input[pos + 3] as i32) << 8)
        pos += 4
        if ((len ^ 0xFFFF) & 0xFFFF) != nlen {
            return error("invalid zlib stored block length")
        }
        if pos + len > input.len {
            return error("truncated zlib stored block data")
        }
        let mut i = 0
        while i < len {
            out.push(input[pos + i])
            i += 1
        }
        pos += len
    }

    if pos + 4 > input.len {
        return error("missing zlib Adler-32 checksum")
    }
    let expected = ((input[pos] as u32) << 24) |
        ((input[pos + 1] as u32) << 16) |
        ((input[pos + 2] as u32) << 8) |
        (input[pos + 3] as u32)
    let actual = hash.adler32(out)
    if expected != actual {
        return error("zlib Adler-32 checksum mismatch")
    }
    return out
}

pub fn compress_string(s: string) -> []u8 {
    return compress(s.bytes())
}

pub fn decompress_string(data: []u8) -> string ! string {
    let bytes = decompress(data)?
    return string.from_bytes(bytes)?
}
