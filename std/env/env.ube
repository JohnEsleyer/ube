package env

// File: std/env/env.ube
//
// Process environment access built on WASI preview1 argv/environ syscalls.
// WASI preview1 is read-only for the environment; `set_var` therefore
// reports false rather than pretending the mutation succeeded.

import "std/collections"

pub fn args() -> []string {
    return os_args()
}

// vars returns a key/value view of the process environment.
pub fn vars() -> collections.SimpleMap[string, string] {
    let mut m = collections.map_new[string, string]()
    for entry in os_environ() {
        let mut eq = -1
        let mut i = 0
        while i < entry.len {
            if entry[i] == 61 {
                eq = i
                break
            }
            i += 1
        }
        if eq > 0 {
            let key = entry[0:eq]
            let val = entry[eq + 1:entry.len]
            m.put(key, val)
        }
    }
    return m
}

pub fn var(key: string) -> string? {
    for entry in os_environ() {
        if entry.len <= key.len {
            continue
        }
        if entry[key.len] != 61 {
            continue
        }
        let mut matches = true
        let mut i = 0
        while i < key.len {
            if entry[i] != key[i] {
                matches = false
                break
            }
            i += 1
        }
        if matches {
            return entry[key.len + 1:entry.len]
        }
    }
    return none
}

pub fn set_var(key: string, val: string) -> bool {
    return false
}

pub fn exit(code: i32) {
    exit_process(code)
}
