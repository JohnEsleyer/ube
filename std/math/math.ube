// Ube standard library: math
//
// Constants are exposed as zero-argument functions because Ube does not yet
// have top-level `let` declarations. Call `PI()` or the lower-case alias
// `pi()`.

pub fn PI() -> f32 { return 3.14159265 }
pub fn TAU() -> f32 { return 6.28318530 }
pub fn E() -> f32 { return 2.71828182 }

pub fn pi() -> f32 { return 3.14159265 }
pub fn tau() -> f32 { return 6.28318530 }
pub fn e() -> f32 { return 2.71828182 }

pub fn min(a: i32, b: i32) -> i32 {
    if a < b { return a }
    return b
}

pub fn max(a: i32, b: i32) -> i32 {
    if a > b { return a }
    return b
}

pub fn clamp(val: i32, low: i32, high: i32) -> i32 {
    if val < low { return low }
    if val > high { return high }
    return val
}

pub fn abs(val: i32) -> i32 {
    if val < 0 { return -val }
    return val
}

pub fn min_f32(a: f32, b: f32) -> f32 {
    if a < b { return a }
    return b
}

pub fn max_f32(a: f32, b: f32) -> f32 {
    if a > b { return a }
    return b
}

pub fn clamp_f32(val: f32, low: f32, high: f32) -> f32 {
    if val < low { return low }
    if val > high { return high }
    return val
}

pub fn abs_f32(val: f32) -> f32 {
    if val < 0.0 { return -val }
    return val
}

pub fn pow(base: f32, exp: i32) -> f32 {
    if exp == 0 { return 1.0 }
    let mut res: f32 = 1.0
    let mut i = 0
    let limit = abs(exp)
    while i < limit {
        res = res * base
        i += 1
    }
    if exp < 0 {
        return 1.0 / res
    }
    return res
}

pub fn powi(base: f32, exp: i32) -> f32 {
    return pow(base, exp)
}

pub fn pow_f32(base: f32, exp: i32) -> f32 {
    return pow(base, exp)
}

pub fn deg_to_rad(deg: f32) -> f32 {
    return deg * (pi() / 180.0)
}

pub fn rad_to_deg(rad: f32) -> f32 {
    return rad * (180.0 / pi())
}
