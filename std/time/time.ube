package time

// File: std/time/time.ube
//
// Idiomatic time abstractions over the WASI preview1 clock primitives.
// `time_now_ns` is backed by CLOCK_MONOTONIC, while `time_now_ms` is
// backed by CLOCK_REALTIME and reports Unix milliseconds.

pub struct Duration {
    pub nanos: i64
}

pub fn duration_from_nanos(n: i64) -> Duration {
    return Duration{ nanos: n }
}

pub fn duration_from_millis(ms: i64) -> Duration {
    return Duration{ nanos: ms * 1000000 }
}

pub fn duration_from_secs(secs: i64) -> Duration {
    return Duration{ nanos: secs * 1000000000 }
}

pub fn (d Duration) as_nanos() -> i64 {
    return d.nanos
}

pub fn (d Duration) as_millis() -> i64 {
    return d.nanos / 1000000
}

pub fn (d Duration) as_secs_f32() -> f32 {
    return (d.nanos as f32) / 1000000000.0
}

pub fn (d Duration) as_secs_f64() -> f64 {
    return (d.nanos as f64) / 1000000000.0
}

pub struct Instant {
    pub nanos: i64
}

// Monotonic clock reading. Use for elapsed-time measurement.
pub fn now() -> Instant {
    return Instant{ nanos: time_now_ns() }
}

pub fn (inst Instant) elapsed() -> Duration {
    return Duration{ nanos: time_now_ns() - inst.nanos }
}

pub struct Timestamp {
    pub unix_millis: i64
}

// Wall-clock reading in Unix milliseconds.
pub fn unix_now() -> Timestamp {
    return Timestamp{ unix_millis: time_now_ms() }
}

pub fn (ts Timestamp) as_millis() -> i64 {
    return ts.unix_millis
}

pub fn sleep(ms: i32) {
    sleep_ms(ms)
}
