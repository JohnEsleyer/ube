package io

// File: std/wasi2/io/streams.ube
//
// WASI 0.2 stream resource wrappers built directly upon wasi:io/streams@0.2.0.

import "std/wasi" as wasi

pub struct InputStream {
	pub handle: i32
}

pub struct OutputStream {
	pub handle: i32
}

pub fn stdin() -> InputStream {
	return InputStream{ handle: wasi.wasi_stdin() }
}

pub fn stdout() -> OutputStream {
	return OutputStream{ handle: wasi.wasi_stdout() }
}

pub fn stderr() -> OutputStream {
	return OutputStream{ handle: wasi.wasi_stderr() }
}

pub fn (s InputStream) handle() -> i32 {
	return s.handle
}

pub fn (s OutputStream) handle() -> i32 {
	return s.handle
}

pub fn (s InputStream) is_closed(status: i32) -> bool {
	return status == wasi.WASI_02_STREAM_CLOSED()
}

pub fn (s OutputStream) is_closed(status: i32) -> bool {
	return status == wasi.WASI_02_STREAM_CLOSED()
}

pub fn (s InputStream) read_bytes(mut buf: []u8) -> i32 ! string {
	let n = wasi.stream_read_bytes(s.handle, mut buf)
	if n == -1 {
		return 0
	}
	if n < 0 {
		return error("wasi:io/streams read failed")
	}
	return n
}

pub fn (s OutputStream) write_bytes(data: []u8) -> bool ! string {
	if data.len == 0 {
		return true
	}
	let st = wasi.stream_write_bytes(s.handle, data)
	if st == -1 {
		return error("output stream is closed")
	}
	if st < 0 {
		return error("wasi:io/streams write failed")
	}
	return true
}

pub fn (s OutputStream) close() {
	wasi.resource_drop_output_stream(s.handle)
}

pub fn (s InputStream) close() {
	wasi.resource_drop_input_stream(s.handle)
}
