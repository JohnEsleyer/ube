// Frame-arena demo: the pattern game engines use for per-frame scratch data.
// Each frame's temporary allocations live in a `tuber` block and are reclaimed
// with a single watermark restore at the end of the frame.

fn simulate_particles(frame: i32) -> i32 {
    let mut particles = []i32{}
    let mut i = 0
    while i < 4 {
        particles.push(frame * 10 + i)
        i = i + 1
    }

    let mut total = 0
    for p in particles {
        total = total + p
    }
    return total
}

fn main() {
    println_str("--- Ube Frame Arena Demo ---")

    let mut frame = 0
    while frame < 3 {
        tuber {
            let total = simulate_particles(frame)
            println_str("Frame scratch total:")
            println(total)
        } // tuber
        frame = frame + 1
    }

    println_str("Three frames, zero heap allocations inside the loop.")
}
