package main

fn test_arena_for_range() {
    let mut count = 0
    arena for i in 0..10 {
        let s = f"item_{i}"
        if s.len > 0 {
            count += 1
        }
    }
    if count != 10 {
        println("FAILED: test_arena_for_range")
    }
}

fn test_arena_for_slice() {
    let items = []string{"alpha", "beta", "gamma"}
    let mut total_len = 0
    arena for item in items {
        let formatted = f"val: {item}"
        total_len += formatted.len
    }
    if total_len == 0 {
        println("FAILED: test_arena_for_slice")
    }
}

fn test_arena_while() {
    let mut i = 0
    let mut sum = 0
    arena while i < 5 {
        let s = f"num_{i}"
        sum += s.len
        i += 1
    }
    if sum == 0 {
        println("FAILED: test_arena_while")
    }
}

fn test_arena_for_break() {
    let mut reached = 0
    arena for i in 0..10 {
        let s = f"step_{i}"
        if i == 4 {
            reached = i
            break
        }
    }
    if reached != 4 {
        println("FAILED: test_arena_for_break")
    }
}

fn test_arena_while_break_and_continue() {
    let mut i = 0
    let mut executed = 0
    arena while i < 8 {
        i += 1
        if i == 2 {
            continue
        }
        let s = f"iter_{i}"
        executed += 1
        if i == 5 {
            break
        }
    }
    if executed != 4 {
        println("FAILED: test_arena_while_break_and_continue")
    }
}

fn test_auto_arena_zero_escape() {
    let mut count = 0
    // Unannotated loop with Tier-2 allocations that do not escape:
    // Compiler automatically promotes this to an arena loop.
    for i in 0..5 {
        let s = f"scratch_{i}"
        if s.len > 0 {
            count += 1
        }
    }
    if count != 5 {
        println("FAILED: test_auto_arena_zero_escape")
    }
}

fn main() {
    test_arena_for_range()
    test_arena_for_slice()
    test_arena_while()
    test_arena_for_break()
    test_arena_while_break_and_continue()
    test_auto_arena_zero_escape()
    println("All arena loop integration tests passed.")
}
