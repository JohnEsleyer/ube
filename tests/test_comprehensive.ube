// 1. WebAssembly Host Import (Safe & Sandboxed)
extern fn host_print(s: string)
extern fn sin(val: f64) -> f64

// 2. Structs & Generational Pool
struct Particle {
    x: f32,
    y: f32,
    active: bool
}

// 3. Tagged Enums with Multi-statement Block Match
enum Command {
    Spawn(f32, f32),
    Despawn(i32),
    Quit
}

// 4. Optional Return Types & if let ... else
fn find_even(num: i32) -> i32? {
    if num % 2 == 0 {
        return num
    } else {
        return none
    }
}

// 5. Result types with custom non-i32 return
fn validate_particle(p: Particle) -> Particle ! string {
    if p.x < 0.0 {
        return error("particle position out of bounds")
    }
    return p
}

// 6. Spawned background task for channels & while let
fn worker_task(ch: Chan[i32]) {
    while let job = ch.recv() {
        println(job)
    }
}

fn main() {
    println("=== 🍠 Running Ube Comprehensive Validation ===")

    let mut particles = []Particle{}
    particles.push(Particle{ x: 10.5, y: 20.0, active: true })
    particles.push(Particle{ x: 30.0, y: 40.5, active: false })
    particles.push(Particle{ x: 50.0, y: 60.0, active: true })
    particles.push(Particle{ x: 70.0, y: 80.0, active: false })
    particles.push(Particle{ x: 90.0, y: 100.0, active: true })

    particles[0].x = 99.0

    println("Iterating generic slice []Particle:")
    for p in particles {
        println(p.x)
    }

    let mut count = 0
    while count < 10 {
        count = count + 1
        if count == 2 || count == 4 { continue }
        if count > 5 && count == 6 { break }
    }
    println(count)

    let found = find_even(42)
    if let val = found {
        println("Found even number:")
        println(val)
    } else {
        println("Number was odd!")
    }

    let bad_p = Particle{ x: -5.0, y: 1.0, active: true }
    let validated = validate_particle(bad_p) or_else Particle{ x: 0.0, y: 0.0, active: false }
    println("Validated fallback x position:")
    println(validated.x)

    let cmd = Command.Spawn(100.0, 200.0)
    match cmd {
        Spawn(x, y) => {
            println("Multi-line match: Spawning particle at:")
            println(x)
            println(y)
        },
        Despawn(id) => {
            println(id)
        },
        Quit => {
            println("Quitting")
        }
    }

    let jobs = Chan[i32].new(4)
    spawn worker_task(jobs)
    jobs.send(777)
    jobs.send(888)
    jobs.close()

    // Test G: Sandboxed WebAssembly Host Import
    host_print("Sandboxed Wasm Host Import executed successfully")

    println("=== All gap fixes successfully verified! ===")
}
