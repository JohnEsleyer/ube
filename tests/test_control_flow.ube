package main

import "std/env"

fn assert(cond: bool) {
    if !cond {
        env.exit(1)
    }
}

fn test_if_expression() {
    let a = 10
    let b = if a > 5 { 100 } else { 200 }
    assert(b == 100)
}

fn test_while_loop() {
    let mut i = 0
    let mut sum = 0
    while i < 5 {
        sum += i
        i += 1
    }
    assert(sum == 10)
    assert(i == 5)
}

fn test_for_in_slice() {
    let arr = []i32{1, 2, 3, 4}
    let mut sum = 0
    for v in arr {
        sum += v
    }
    assert(sum == 10)
}

fn test_break_and_continue() {
    let mut sum = 0
    let mut i = 0
    while i < 10 {
        i += 1
        if i % 2 == 0 {
            continue
        }
        if i > 7 {
            break
        }
        sum += i
    }
    assert(sum == 16)
}

fn main() {}
