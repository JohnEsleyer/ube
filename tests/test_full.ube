enum Event {
    Data(i32),
    Stop
}

fn parse_number(code: i32) -> i32 ! string {
    if code == 0 {
        return error("invalid zero code")
    }
    return code * 10
}

fn vine_fn(ch: Chan[i32], done: Chan[i32]) {
    println_str("Spawned Vine active on background thread!")
    let val = ch.recv()
    println_str("Vine received value from channel:")
    println(val)
    done.send(1)
    return
}

fn main() {
    println_str("=== Complete Ube Feature Test ===")

    let channel = Chan[i32].new(5)
    let done = Chan[i32].new(1)

    println_str("Main thread spawning Vine...")
    spawn vine_fn(channel, done)
    channel.send(42)

    let finished = done.recv()
    done.close()
    channel.close()

    let good = parse_number(5) or_else 999
    let bad = parse_number(0) or_else 999

    println_str("Testing `or_else` on success (expected 50):")
    println(good)
    println_str("Testing `or_else` on error (expected fallback 999):")
    println(bad)

    scope {
        let scratch_val = 1234
        println_str("Scoped execution running cleanly:")
        println(scratch_val)
    }

    println_str("=== All features ran with zero GC! ===")
}
