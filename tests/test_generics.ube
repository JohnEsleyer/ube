package main

import "std/env"

fn assert(cond: bool) {
    if !cond {
        env.exit(1)
    }
}

struct Pair[A, B] {
    first: A,
    second: B
}

fn make_pair[A, B](a: A, b: B) -> Pair[A, B] {
    return Pair[A, B]{ first: a, second: b }
}

fn test_generic_struct() {
    let p = Pair[i32, f32]{ first: 42, second: 3.14 }
    assert(p.first == 42)
    let diff = p.second - 3.14
    assert(diff > -0.001)
    assert(diff < 0.001)
}

fn test_generic_function() {
    let p = make_pair[i32, i32](10, 20)
    assert(p.first == 10)
    assert(p.second == 20)
}

fn main() {}
