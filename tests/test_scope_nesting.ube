// Nested arena restores must preserve allocations made by the outer arena.
fn main() {
    let mut outer = []i32{}
    outer.push(1)

    arena {
        let mut inner = []i32{}
        inner.push(10)
        arena {
            let mut nested = []i32{}
            nested.push(100)
            println(nested[0])
        }
        println(inner[0])
    }

    outer.push(2)
    println(outer[0])
    println(outer[1])
}
