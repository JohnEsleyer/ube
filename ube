#!/usr/bin/env python3
import sys
import os
import subprocess
import hashlib
import json
import re

CACHE_DIR = os.path.expanduser("~/.ube/pkg")
LOCK_FILE = "ube.mod.lock"

def print_banner(msg): print(f"\033[1;35m🍠 Ube\033[0m {msg}")
def print_error(msg): print(f"\033[1;31mError:\033[0m {msg}")

def read_lockfile():
    if os.path.exists(LOCK_FILE):
        with open(LOCK_FILE, "r") as f: return json.load(f)
    return {}

def write_lockfile(data):
    with open(LOCK_FILE, "w") as f: json.dump(data, f, indent=2)

def sanitize_pkg_path(pkg_url):
    clean = re.sub(r"^(https?://|git@|ssh://)", "", pkg_url)
    clean = clean.replace(":", "/")
    if clean.endswith(".git"):
        clean = clean[:-4]
    return clean

def cmd_new(args):
    if not args:
        print_error("Please provide a project name: ube new <project_name>")
        return
    name = args[0]
    if os.path.exists(name):
        print_error(f"Directory '{name}' already exists.")
        return

    os.makedirs(name)
    with open(os.path.join(name, "ube.mod"), "w") as f:
        f.write(f"module {name}\n\nrequire (\n)\n")

    with open(os.path.join(name, "main.ube"), "w") as f:
        f.write('package main\n\nfn main() {\n    println("Kamusta from Ube! 🍠")\n}\n')

    print_banner(f"Created new project \033[1;32m{name}\033[0m")
    print(f"  cd {name}")
    print("  ube run")

def cmd_vendor():
    if not os.path.exists("ube.mod"):
        print_error("No ube.mod found in current directory.")
        return
    lock_data = read_lockfile()
    os.makedirs("vendor", exist_ok=True)
    print_banner("Vendoring packages into \033[1;32m./vendor/\033[0m...")

    # If lockfile exists, vendor from lockfile, otherwise parse ube.mod
    vendored_any = False
    if lock_data:
        for pkg, info in lock_data.items():
            src = os.path.join(CACHE_DIR, pkg)
            dst = os.path.join("vendor", pkg)
            if os.path.exists(src):
                os.makedirs(os.path.dirname(dst), exist_ok=True)
                subprocess.run(["cp", "-r", src, dst], check=True)
                print(f"  Vendored: {pkg}")
                vendored_any = True
    else:
        with open("ube.mod", "r") as f:
            content = f.read()
        m = re.search(r"require\s*\(([^)]*)\)", content, re.DOTALL)
        if m:
            deps = [line.strip() for line in m.group(1).splitlines() if line.strip()]
            for dep in deps:
                rel_path = sanitize_pkg_path(dep)
                src = os.path.join(CACHE_DIR, rel_path)
                dst = os.path.join("vendor", rel_path)
                if os.path.exists(src):
                    os.makedirs(os.path.dirname(dst), exist_ok=True)
                    subprocess.run(["cp", "-r", src, dst], check=True)
                    print(f"  Vendored: {rel_path}")
                    vendored_any = True

    print_banner("Vendoring complete! Project is now 100% offline-ready.")

def cmd_test():
    print_banner("Running test suite...")
    test_files = [f for f in os.listdir(".") if f.startswith("test_") and f.endswith(".ube")]
    if not test_files:
        print_error("No test_*.ube files found.")
        return
    passed = 0
    for t in sorted(test_files):
        print(f"  Executing {t} ... ", end="", flush=True)
        res = subprocess.run([sys.executable, "ubec.py", t], capture_output=True, text=True)
        if res.returncode != 0:
            print("\033[1;31mFAIL (Compile)\033[0m")
            print(res.stderr)
            continue
        c_res = subprocess.run(["gcc", "-O2", "output.c", "-lpthread", "-lm", "-o", ".test_bin"], capture_output=True, text=True)
        if c_res.returncode != 0:
            print("\033[1;31mFAIL (C Link)\033[0m")
            print(c_res.stderr)
            continue
        run_res = subprocess.run(["./.test_bin"], capture_output=True, text=True)
        if run_res.returncode == 0:
            print("\033[1;32mPASS\033[0m")
            passed += 1
        else:
            print(f"\033[1;31mFAIL (Exit {run_res.returncode})\033[0m")
            print(run_res.stderr)
        if os.path.exists(".test_bin"): os.remove(".test_bin")
    print_banner(f"Test Summary: {passed}/{len(test_files)} passed.")

def cmd_build(args):
    target = "main.ube"
    out_name = "app"
    is_wasm = "--wasm" in args
    is_static = "--static" in args
    
    i = 0
    while i < len(args):
        arg = args[i]
        if arg == "-o" and i + 1 < len(args):
            out_name = args[i+1]
            i += 2
            continue
        elif not arg.startswith("-"):
            target = arg
        i += 1

    res = subprocess.run([sys.executable, "ubec.py", target] + (["--wasm"] if is_wasm else []))
    if res.returncode != 0: return

    if is_wasm:
        wasm_out = out_name if out_name.endswith(".wasm") else f"{out_name}.wasm"
        print_banner(f"Compiling WebAssembly -> \033[1;32m{wasm_out}\033[0m")
        subprocess.run(["clang", "--target=wasm32-wasi", "-O3", "-nostdlib", 
                        "-Wl,--no-entry", "-Wl,--export-all", "-o", wasm_out, "output.c"], check=True)
    else:
        gcc_cmd = ["gcc", "-O2", "output.c", "-lpthread", "-lm", "-o", out_name]
        if is_static: gcc_cmd.append("-static")
        subprocess.run(gcc_cmd, check=True)
        print_banner(f"Built native static binary -> \033[1;32m{out_name}\033[0m")

def cmd_clean(args):
    import shutil
    dry_run = "--dry-run" in args
    wipe_cache = "--cache" in args
    if not dry_run and not wipe_cache:
        print("Usage: ube clean [--dry-run | --cache]")
        return
    total_bytes = 0
    pkg_count = 0
    if os.path.exists(CACHE_DIR):
        for dirpath, dirnames, filenames in os.walk(CACHE_DIR):
            for fname in filenames:
                total_bytes += os.path.getsize(os.path.join(dirpath, fname))
        for root, dirs, _ in os.walk(CACHE_DIR):
            depth = root.replace(CACHE_DIR, "").count(os.sep)
            if depth == 2: pkg_count += len(dirs)
    size_mb = total_bytes / (1024 * 1024)
    if dry_run:
        print_banner(f"Global cache: {size_mb:.1f} MB across {pkg_count} package(s)")
    elif wipe_cache:
        if os.path.exists(CACHE_DIR):
            shutil.rmtree(CACHE_DIR)
            print_banner(f"Cleared {size_mb:.1f} MB from global cache.")

def main():
    if len(sys.argv) < 2:
        print("\033[1;35m🍠 Ube Toolchain\033[0m [test | vendor | build | run | get | new | clean]")
        return
    cmd = sys.argv[1]
    if cmd == "test": cmd_test()
    elif cmd == "vendor": cmd_vendor()
    elif cmd == "build": cmd_build(sys.argv[2:])
    elif cmd == "new": cmd_new(sys.argv[2:])
    elif cmd == "clean": cmd_clean(sys.argv[2:])
    elif cmd == "run":
        target = sys.argv[2] if len(sys.argv) > 2 else "main.ube"
        subprocess.run([sys.executable, "ubec.py", target], check=True)
        subprocess.run(["gcc", "-O0", "output.c", "-lpthread", "-lm", "-o", ".temp_run"], check=True)
        subprocess.run(["./.temp_run"])
        if os.path.exists(".temp_run"): os.remove(".temp_run")

if __name__ == "__main__": main()
