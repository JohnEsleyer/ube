#!/usr/bin/env python3
import sys
import os
import subprocess
import time
import shutil
import re

# --- Minimalist 24-Bit / ANSI Palette ---
CLR_RESET   = "\033[0m"
CLR_BOLD    = "\033[1m"
CLR_DIM     = "\033[2m"

# Brand Colors (Ube Violet & Accents)
CLR_UBE     = "\033[38;2;192;132;252m"  # Ube light violet
CLR_UBEDARK = "\033[38;2;126;34;206m"   # Deep purple
CLR_SUCCESS = "\033[38;2;52;211;153m"   # Mint / Emerald
CLR_AMBER   = "\033[38;2;251;191;36m"   # Warm Gold / Warning
CLR_BLUE    = "\033[38;2;96;165;250m"   # Cyan / Info
CLR_MUTED   = "\033[38;2;148;163;184m"  # Slate text
CLR_LINE    = "\033[38;2;51;65;85m"     # Dark Slate for box drawing
CLR_RED     = "\033[38;2;248;113;113m"  # Soft Red for errors

def tag(label, color):
    # Left-aligned fixed width action tag (like Cargo / Bun)
    return f"{color}{CLR_BOLD}{label:>12}{CLR_RESET}  "

def print_header(action=""):
    act_str = f" {CLR_DIM}• {action}{CLR_RESET}" if action else ""
    print(f"\n{CLR_UBE}{CLR_BOLD}🍠 Ube{CLR_RESET} {CLR_MUTED}v0.4.0{CLR_RESET}{act_str}")

def format_size(bytes_sz):
    if bytes_sz < 1024:
        return f"{bytes_sz} B"
    elif bytes_sz < 1024 * 1024:
        return f"{bytes_sz / 1024:.1f} KB"
    else:
        return f"{bytes_sz / (1024 * 1024):.1f} MB"

def scan_safety(filepath):
    """Scans code for C FFI symbols to generate the Safety Audit."""
    unsafe_items = []
    if not os.path.exists(filepath):
        return unsafe_items
    with open(filepath, "r", errors="ignore") as f:
        for idx, line in enumerate(f):
            s = line.strip()
            if s.startswith("extern fn "):
                m = re.match(r"extern\s+fn\s+(\w+)", s)
                if m:
                    unsafe_items.append(("Direct FFI", f"extern fn {m.group(1)}()", idx + 1))
            elif s.startswith("#c_include"):
                inc = s.split(None, 1)[1].strip()
                unsafe_items.append(("Pragma", f'#c_include {inc}', idx + 1))
            elif s.startswith("#c_source"):
                src = s.split(None, 1)[1].strip()
                unsafe_items.append(("C Source", f'#c_source {src}', idx + 1))
    return unsafe_items

# --- Subcommand: ube build ---
def cmd_build(args):
    start_time = time.perf_counter()
    target = "main.ube"
    out_name = "app"
    is_static = "--static" in args
    is_wasm = "--wasm" in args
    is_release = "--release" in args or "-O" in args

    i = 0
    while i < len(args):
        arg = args[i]
        if arg == "-o" and i + 1 < len(args):
            out_name = args[i+1]
            i += 2
            continue
        elif not arg.startswith("-") and arg.endswith(".ube"):
            target = arg
        i += 1

    if not os.path.exists(target):
        print(f"\n{CLR_RED}{CLR_BOLD}error{CLR_RESET}: Cannot locate entry file '{target}'\n")
        return False

    print_header("build")
    print(f"{tag('Compiling', CLR_UBE)}{target}")

    # Step 1: Transpilation via ubec.py
    print(f"{tag('Analyzing', CLR_BLUE)}Tubers & Root lifetimes")
    transpiler = os.path.join(os.path.dirname(__file__), "ubec.py")
    if not os.path.exists(transpiler):
        transpiler = "ubec.py"

    cmd_args = [sys.executable, transpiler, target]
    if is_wasm:
        cmd_args.append("--wasm")

    res = subprocess.run(cmd_args, capture_output=True, text=True)
    if res.returncode != 0:
        print(f"\n{CLR_RED}{CLR_BOLD}build failed{CLR_RESET}")
        print(f"{CLR_LINE}{'─'*60}{CLR_RESET}")
        print(res.stderr.strip())
        print(f"{CLR_LINE}{'─'*60}{CLR_RESET}\n")
        return False

    # Step 2: C Compilation
    link_info = "output.c (gcc -O3 -lpthread -lm)" if is_release else "output.c (gcc -O0 -lpthread -lm)"
    if is_static: link_info += " [static]"
    if is_wasm:   link_info = "output.c (clang --target=wasm32-wasi)"

    print(f"{tag('Linking', CLR_BLUE)}{link_info}")

    if is_wasm:
        wasm_out = out_name if out_name.endswith(".wasm") else f"{out_name}.wasm"
        gcc_cmd = ["clang", "--target=wasm32-wasi", "-O3", "-nostdlib", 
                    "-Wl,--no-entry", "-Wl,--export-all", "-o", wasm_out, "output.c"]
        final_binary = wasm_out
    else:
        opt_flag = "-O3" if is_release else "-O0"
        gcc_cmd = ["gcc", opt_flag, "output.c", "-lpthread", "-lm", "-o", out_name]
        if is_static:
            gcc_cmd.append("-static")
        final_binary = out_name

    c_res = subprocess.run(gcc_cmd, capture_output=True, text=True)
    if c_res.returncode != 0:
        print(f"\n{CLR_RED}{CLR_BOLD}c linker error{CLR_RESET}")
        print(c_res.stderr)
        return False

    elapsed_ms = int((time.perf_counter() - start_time) * 1000)
    profile = "release [optimized]" if is_release else "dev [unoptimized]"
    print(f"{tag('Finished', CLR_SUCCESS)}{profile} in {CLR_BOLD}{elapsed_ms}ms{CLR_RESET}")

    # Step 3: Minimalist Summary Card
    bin_size = format_size(os.path.getsize(final_binary))
    print(f"\n   {CLR_MUTED}Artifact{CLR_RESET}    {CLR_BOLD}./{final_binary}{CLR_RESET} {CLR_DIM}({bin_size}){CLR_RESET}")

    # Safety Audit Report
    unsafe_items = scan_safety(target)
    if not unsafe_items:
        print(f"   {CLR_MUTED}Safety{CLR_RESET}      {CLR_SUCCESS}🛡️  100% Pure Ube (Zero GC, Memory-Safe){CLR_RESET}\n")
    else:
        print(f"   {CLR_MUTED}Safety{CLR_RESET}      {CLR_AMBER}⚡ Hybrid Boundary (External C FFI){CLR_RESET}")
        for idx, (kind, name, line_no) in enumerate(unsafe_items):
            branch = "└──" if idx == len(unsafe_items) - 1 else "├──"
            print(f"               {CLR_LINE}{branch}{CLR_RESET} {kind}: {CLR_UBE}{name}{CLR_RESET} {CLR_DIM}(line {line_no}){CLR_RESET}")
        print()

    return True

# --- Subcommand: ube run ---
def cmd_run(args):
    target = "main.ube"
    for arg in args:
        if arg.endswith(".ube"):
            target = arg
            break

    temp_bin = ".temp_ube_run"
    success = cmd_build([target, "-o", temp_bin])
    if success and os.path.exists(temp_bin):
        print(f"{tag('Running', CLR_SUCCESS)}{target}\n{CLR_LINE}{'─'*50}{CLR_RESET}")
        run_start = time.perf_counter()
        subprocess.run([f"./{temp_bin}"])
        run_ms = int((time.perf_counter() - run_start) * 1000)
        print(f"{CLR_LINE}{'─'*50}{CLR_RESET}")
        print(f"{tag('Exited', CLR_MUTED)}Process completed in {run_ms}ms\n")
        os.remove(temp_bin)
        if os.path.exists("output.c"):
            os.remove("output.c")

# --- Subcommand: ube test ---
def cmd_test():
    print_header("test runner")
    test_files = [f for f in sorted(os.listdir(".")) if f.startswith("test_") and f.endswith(".ube")]
    if not test_files:
        print(f"\n   {CLR_MUTED}No test files found matching `test_*.ube`{CLR_RESET}\n")
        return

    print(f"   {CLR_MUTED}Discovered {len(test_files)} test suite(s):{CLR_RESET}\n")
    passed = 0
    total_start = time.perf_counter()

    for t in test_files:
        print(f"   • {t:<28}", end="", flush=True)
        t_start = time.perf_counter()
        
        # Compile
        res = subprocess.run([sys.executable, "ubec.py", t], capture_output=True, text=True)
        if res.returncode != 0:
            print(f" {CLR_RED}FAIL (Transpile){CLR_RESET}")
            continue
            
        c_res = subprocess.run(["gcc", "-O0", "output.c", "-lpthread", "-lm", "-o", ".test_tmp"], capture_output=True)
        if c_res.returncode != 0:
            print(f" {CLR_RED}FAIL (C Link){CLR_RESET}")
            continue

        run_res = subprocess.run(["./.test_tmp"], capture_output=True)
        t_ms = int((time.perf_counter() - t_start) * 1000)

        if run_res.returncode == 0:
            print(f" {CLR_SUCCESS}ok{CLR_RESET} {CLR_DIM}[{t_ms}ms]{CLR_RESET}")
            passed += 1
        else:
            print(f" {CLR_RED}FAIL{CLR_RESET} (exit {run_res.returncode}) {CLR_DIM}[{t_ms}ms]{CLR_RESET}")

        if os.path.exists(".test_tmp"):
            os.remove(".test_tmp")

    total_ms = int((time.perf_counter() - total_start) * 1000)
    print(f"\n   {CLR_LINE}{'─'*40}{CLR_RESET}")
    print(f"   {CLR_MUTED}Results:{CLR_RESET}  {CLR_SUCCESS}{passed} passed{CLR_RESET}, {len(test_files) - passed} failed in {total_ms}ms\n")

# --- Subcommand: ube new ---
def cmd_new(args):
    if not args:
        print(f"\n{CLR_RED}error{CLR_RESET}: Please specify a project name: ube new <name>\n")
        return
    name = args[0]
    os.makedirs(name, exist_ok=True)
    with open(os.path.join(name, "ube.mod"), "w") as f:
        f.write(f"module {name}\n\nrequire (\n)\n")
    with open(os.path.join(name, "main.ube"), "w") as f:
        f.write('package main\n\nfn main() {\n    println("Kamusta, Ube! 🍠")\n}\n')

    print_header("scaffold")
    print(f"   {CLR_SUCCESS}✔{CLR_RESET} Created project {CLR_BOLD}{name}{CLR_RESET}")
    print(f"\n   To get started:\n     cd {name}\n     ube run\n")

def main():
    if len(sys.argv) < 2:
        print(f"""
{CLR_UBE}{CLR_BOLD}🍠 Ube Programming Language{CLR_RESET}
{CLR_MUTED}Fast as C. Simple as Go. Zero Garbage Collection.{CLR_RESET}

{CLR_BOLD}USAGE:{CLR_RESET}
    ube <COMMAND> [OPTIONS]

{CLR_BOLD}COMMANDS:{CLR_RESET}
    {CLR_SUCCESS}run{CLR_RESET}        [file.ube]           Compile and run instantly
    {CLR_SUCCESS}build{CLR_RESET}      [-o app] [--release] Build optimized static binary
    {CLR_SUCCESS}test{CLR_RESET}                           Run all test_*.ube suites
    {CLR_SUCCESS}new{CLR_RESET}        <project_name>       Scaffold a new project
    {CLR_SUCCESS}get{CLR_RESET}        <git_url>            Download decentralized package
""")
        return

    cmd = sys.argv[1]
    args = sys.argv[2:]

    if cmd == "run":
        cmd_run(args)
    elif cmd == "build":
        cmd_build(args)
    elif cmd == "test":
        cmd_test()
    elif cmd == "new":
        cmd_new(args)
    else:
        print(f"{CLR_RED}error{CLR_RESET}: Unknown command '{cmd}'. See 'ube' for usage.")

if __name__ == "__main__":
    main()
