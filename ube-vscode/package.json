{
  "name": "ube-vscode",
  "displayName": "Ube Language Support",
  "description": "Rich language support for the Ube programming language 🍠",
  "version": "0.4.0",
  "publisher": "ube-lang",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ube-lang/ube"
  },
  "engines": { "vscode": "^1.70.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [{
      "id": "ube",
      "aliases": ["Ube", "ube"],
      "extensions": [".ube"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "ube",
      "scopeName": "source.ube",
      "path": "./syntaxes/ube.tmLanguage.json"
    }]
  }
}
